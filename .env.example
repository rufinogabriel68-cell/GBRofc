# ============================================================
# GBR GESTÃO — variáveis de ambiente
# ============================================================
# Backend de dados:
#   - Com as variáveis NEXT_PUBLIC_FIREBASE_* preenchidas => Cloud Firestore + Cloud Storage (multi-dispositivo, offline).
#   - Sem elas => modo servidor (PostgreSQL via DATABASE_URL) com o mesmo modelo de coleções.
# Forçar PostgreSQL mesmo com Firebase configurado: NEXT_PUBLIC_DATA_BACKEND=postgres

# --- Firebase (config PÚBLICA do app web; não é segredo) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# App Check (reCAPTCHA v3) — recomendado em produção
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Use "false" para desativar o login anônimo (só faça isso após implantar Firebase Auth real)
NEXT_PUBLIC_FIREBASE_ANON_AUTH=true

# --- Multiempresa (padrão: uma empresa) ---
NEXT_PUBLIC_COMPANY_ID=gbr-principal

# --- PostgreSQL (modo servidor) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- IA (opcional; sem chave a IA fica desativada) ---
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# --- Futuro ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
